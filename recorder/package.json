{
  "name": "sumo-ring-recorder",
  "private": true,
  "type": "module",
  "description": "Records the sumo Twitch stream and cuts each bout into a clip for Sumo Ring.",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "watch": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/watch.ts",
    "record": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/record.ts",
    "replay": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/replay.ts",
    "probe": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/probe.ts",
    "typecheck": "tsc --noEmit",
    "upload": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/upload.ts",
    "daily": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/daily.ts"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5"
  }
}
