# Copy to .env.local and fill in

# Sumo API
SUMO_API_BASE_URL=https://www.sumo-api.com

# Hygraph (streams, clips, news)
HYGRAPH_ENDPOINT=
HYGRAPH_TOKEN=

# Firebase (client)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server — used to verify the admin custom claim)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Dev only: during `npm run dev` every visitor is treated as admin (can add/edit streams and clips).
# Set to false to test the real admin restriction locally. Has no effect in production builds.
DEV_ADMIN=true
