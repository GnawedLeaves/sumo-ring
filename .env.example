# Copy to .env.local and fill in

# Sumo API
SUMO_API_BASE_URL=https://www.sumo-api.com

# Hygraph (streams, clips, news)
HYGRAPH_ENDPOINT=
HYGRAPH_TOKEN=

# Firebase (client)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server — used to verify the admin custom claim)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# TEMPORARY: editing (streams, clips) is open to every visitor, in dev and production.
# Set to true to restrict editing to users with the Firebase `admin` claim.
ADMIN_EMAILS=
# ADMIN_OPEN=true  # local testing only: everyone gets admin features. Never set in production.

# News ingest (src/lib/news): DeepL machine-translates Japanese sumo headlines + leads. Free keys end in ":fx".
DEEPL_API_KEY=
# Shared secret for GET /api/cron/news (sent as "Authorization: Bearer <secret>"). Use a long random string.
CRON_SECRET=

# Telegram bot (src/lib/telegram.ts): sends clips with the bout title as the caption. Setup: README "Telegram bot".
TELEGRAM_BOT_TOKEN=
# Username without the @ (for t.me links), e.g. sumoring_bot
TELEGRAM_BOT_USERNAME=
# Random string; also passed as secret_token to setWebhook so only Telegram can call /api/telegram
TELEGRAM_WEBHOOK_SECRET=

# Auto-clipper worker -> /api/recorder/* (Authorization: Bearer ...). Any long random string; set the same value on the worker.
RECORDER_SECRET=
